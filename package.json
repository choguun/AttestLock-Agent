{
  "name": "attestlock-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "0.2.1",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.17.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/**' --filter './apps/**' build && pnpm contracts:build",
    "contracts:build": "forge build --root contracts",
    "contracts:coverage": "bash scripts/contracts-coverage.sh",
    "contracts:fmt": "forge fmt --root contracts",
    "contracts:fmt:check": "forge fmt --root contracts --check",
    "contracts:test": "forge test --root contracts -vvv",
    "deployments:manifest": "node scripts/generate-deployment-manifest.mjs",
    "deployments:prepare": "node scripts/prepare-deployment.mjs",
    "evidence:live": "node scripts/verify-live-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm --filter './packages/**' --filter './apps/**' test && pnpm contracts:test",
    "test:e2e": "playwright test",
    "test:web-config": "bash scripts/test-web-production-config.sh",
    "typecheck": "pnpm --filter @attestlock/shared typecheck && pnpm --filter @attestlock/shared build && pnpm --filter './apps/**' typecheck",
    "verify": "pnpm format:check && pnpm contracts:fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:web-config && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.55.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "railway": "3.11.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.42.0"
  }
}
