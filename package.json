{
  "name": "attestlock-agent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "0.2.1",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "5.4.0",
    "ethers": "^6.17.0"
  },
  "scripts": {
    "build": "pnpm --filter './packages/**' --filter './apps/**' build && pnpm contracts:build",
    "contracts:build": "forge build --root contracts",
    "contracts:fmt": "forge fmt --root contracts",
    "contracts:fmt:check": "forge fmt --root contracts --check",
    "contracts:test": "forge test --root contracts -vvv",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test": "pnpm --filter './packages/**' --filter './apps/**' test && pnpm contracts:test",
    "typecheck": "pnpm --filter @attestlock/shared typecheck && pnpm --filter @attestlock/shared build && pnpm --filter './apps/**' typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.42.0"
  }
}
